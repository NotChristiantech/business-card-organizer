# Claude API key — used to read/parse business card photos into structured fields.
ANTHROPIC_API_KEY=sk-ant-...

# GoHighLevel Private Integration Token (Settings -> Private Integrations in the
# sub-account/location you want contacts created in). Starts with "pit-...".
# Leave blank to keep GHL sync disabled (the app works fully without it).
GHL_PRIVATE_TOKEN=

# The GoHighLevel Location ID for that same sub-account (Settings -> Business Profile,
# or visible in the sub-account's URL).
GHL_LOCATION_ID=
