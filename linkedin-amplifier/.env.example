# Claude API key — powers voice extraction, idea mining, and draft generation.
# Required.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model. Defaults to claude-sonnet-5.
# CLAUDE_MODEL=claude-sonnet-5

# Fireflies API key — lets the app pull your recent meetings directly.
# Fireflies -> Settings -> Developer Settings -> API Key.
# Leave blank and you can still paste transcripts by hand; nothing else changes.
FIREFLIES_API_KEY=
